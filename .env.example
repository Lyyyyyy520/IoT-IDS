# Runtime mode: development or production
IOT_IDS_ENV=development
IOT_IDS_FLASK_DEBUG=false

# One explicit, existing SQLite file shared by legacy APIs and v3 services.
# The backend never creates or migrates this path during normal startup.
IOT_IDS_DATABASE_PATH=D:/path/to/verified/iot-ids.sqlite

# Generate unique secrets locally.  Do not commit real values.
IOT_IDS_SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
IOT_IDS_PROBE_TOKEN=CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_VALUE

# Optional one-time bootstrap for an empty database. Leave the password blank
# in templates and provide a unique value only in the local runtime environment.
IOT_IDS_BOOTSTRAP_ADMIN_USERNAME=admin
IOT_IDS_BOOTSTRAP_ADMIN_PASSWORD=

# APP pairing and opaque mobile sessions. Use a unique secret of at least 32
# characters. Plain HTTP is disabled by default and may only be enabled for an
# explicit loopback/isolated development environment.
IOT_IDS_MOBILE_TOKEN_SECRET=CHANGE_ME_TO_A_SEPARATE_LONG_RANDOM_VALUE
IOT_IDS_MOBILE_ALLOW_INSECURE_HTTP=false
IOT_IDS_MOBILE_TRUST_PROXY=false
IOT_IDS_MOBILE_PAIRING_TTL_SECONDS=300
IOT_IDS_MOBILE_ACCESS_TTL_SECONDS=1800
IOT_IDS_MOBILE_REFRESH_TTL_SECONDS=2592000
IOT_IDS_MOBILE_PAIRING_MAX_ATTEMPTS=5
IOT_IDS_MOBILE_RATE_WINDOW_SECONDS=300
IOT_IDS_MOBILE_RATE_BLOCK_SECONDS=300
IOT_IDS_MOBILE_CLAIM_RATE_LIMIT=10
IOT_IDS_MOBILE_REFRESH_RATE_LIMIT=20

# Browser origins allowed to use cookie-authenticated legacy Web APIs.
IOT_IDS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Phase 0 laboratory safety boundary.  Attack simulation remains disabled in
# firmware until explicitly enabled in the untracked device_secrets.h file.
IOT_IDS_LAB_ALLOWED_CIDRS=192.168.4.0/24
IOT_IDS_LAB_ATTACK_TARGET=192.168.4.200

# MQTT is opt-in. These are placeholders; never commit deployment credentials.
IOT_IDS_MQTT_ENABLED=false
IOT_IDS_MQTT_HOST=mqtt.gateway.invalid
IOT_IDS_MQTT_PORT=1883
IOT_IDS_MQTT_BACKEND_USERNAME=CHANGE_ME_BACKEND_SUBSCRIBER_USERNAME
IOT_IDS_MQTT_BACKEND_PASSWORD=CHANGE_ME_BACKEND_MQTT_PASSWORD
IOT_IDS_MQTT_CLIENT_ID=CHANGE_ME_UNIQUE_BACKEND_CLIENT_ID
IOT_IDS_MQTT_KEEPALIVE=60
IOT_IDS_MQTT_QOS=1
# Plaintext is permitted only when explicitly configured on the isolated LAN.
IOT_IDS_MQTT_TLS_ENABLED=false
IOT_IDS_MQTT_CA_FILE=CHANGE_ME_ABSOLUTE_CA_FILE_PATH
IOT_IDS_MQTT_QUEUE_SIZE=256
IOT_IDS_MQTT_RECONNECT_MIN_SECONDS=1
IOT_IDS_MQTT_RECONNECT_MAX_SECONDS=60
IOT_IDS_MQTT_RECONNECT_JITTER=0.2

# Explicit database maintenance only; no automatic scheduler is enabled.
# Each policy accepts 1-36500 days. Review docs/12-operations-and-recovery.md.
IOT_IDS_RETENTION_LEGACY_TRAFFIC_LOGS_DAYS=30
IOT_IDS_RETENTION_REALTIME_EVENTS_DAYS=30
IOT_IDS_RETENTION_DEVICE_OBSERVATIONS_DAYS=90
IOT_IDS_RETENTION_MQTT_BOOT_SESSIONS_DAYS=180
IOT_IDS_RETENTION_DEVICE_IP_BINDINGS_DAYS=365
IOT_IDS_RETENTION_TRAFFIC_AGGREGATES_DAYS=365
IOT_IDS_RETENTION_TRAFFIC_DEDUPLICATION_DAYS=90
IOT_IDS_RETENTION_UNKNOWN_DEVICE_OBSERVATIONS_DAYS=180
IOT_IDS_RETENTION_MOBILE_PAIRINGS_DAYS=30
IOT_IDS_RETENTION_MOBILE_SESSIONS_DAYS=90
IOT_IDS_RETENTION_MOBILE_REFRESH_HISTORY_DAYS=90
IOT_IDS_RETENTION_MOBILE_RATE_LIMITS_DAYS=2
IOT_IDS_RETENTION_INCIDENT_TIMELINE_DAYS=2555
IOT_IDS_RETENTION_HELP_TIMELINE_DAYS=2555
IOT_IDS_RETENTION_HELP_REQUESTS_DAYS=2555
IOT_IDS_RETENTION_MOBILE_USER_CONFIRMATIONS_DAYS=2555
IOT_IDS_RETENTION_MOBILE_NOTICE_CHANGES_DAYS=2555
IOT_IDS_RETENTION_AUDIT_RECORDS_DAYS=2555
